{
  "name": "kill-stack",
  "displayName": "Kill Stack",
  "description": "Stop local server processes from VS Code. Includes a kill-on-exit option. Works on Windows, macOS, and Linux. Detects many common local server frameworks, runtimes, and tunnels.",
  "version": "1.1.0",
  "publisher": "RedRiverDesign",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Protogenus/kill-stack.git"
  },
  "homepage": "https://github.com/Protogenus/kill-stack",
  "bugs": {
    "url": "https://github.com/Protogenus/kill-stack/issues"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vscode",
    "extension",
    "stop",
    "kill",
    "stack",
    "local-server",
    "process-manager",
    "dev-server",
    "local-dev",
    "tunnel"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "killStack",
          "title": "Kill Stack",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "killStack": [
        {
          "id": "killStack.servers",
          "name": "Local Servers",
          "icon": "images/activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "killStack.showProcesses",
        "title": "Kill Stack: Open Dashboard"
      },
      {
        "command": "killStack.statusMenu",
        "title": "Kill Stack: Quick Menu"
      },
      {
        "command": "killStack.killPort",
        "title": "Kill Stack: Kill Process on Port…"
      },
      {
        "command": "killStack.killAll",
        "title": "Kill Stack: Kill All Local Servers",
        "icon": "$(debug-stop)"
      },
      {
        "command": "killStack.killServer",
        "title": "Kill Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "killStack.refresh",
        "title": "Kill Stack: Refresh Dashboard",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "killStack.refresh",
          "when": "view == killStack.servers",
          "group": "navigation"
        },
        {
          "command": "killStack.killAll",
          "when": "view == killStack.servers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "killStack.killServer",
          "when": "view == killStack.servers && viewItem == server",
          "group": "inline"
        },
        {
          "command": "killStack.killServer",
          "when": "view == killStack.servers && viewItem == server",
          "group": "1_kill"
        }
      ],
      "commandPalette": [
        {
          "command": "killStack.killServer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Kill Stack",
      "properties": {
        "killStack.killOnExit": {
          "type": "boolean",
          "default": false,
          "description": "Kill local server processes started from this window's folders when VS Code exits. On macOS, prompt first."
        },
        "killStack.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Servers whose command line contains any of these strings (case-insensitive) are never stopped by Kill All or Kill On Exit. Stopping them one at a time still works."
        },
        "killStack.autoRefreshInterval": {
          "type": "number",
          "default": 5,
          "description": "Auto-refresh interval in seconds (0 to disable)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test",
    "test:integration": "npm run compile && node integration/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.0.0"
  }
}
